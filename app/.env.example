# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so
# only put public keys here (never the Supabase service-role key).
# Payments go through Paystack on the server, so no payment keys belong here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
