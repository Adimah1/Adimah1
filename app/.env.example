# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so
# only put public keys here (never the Supabase service-role key).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat public SDK keys (Project settings → API keys). Leave blank to
# run without purchases (e.g. in Expo Go).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Stripe publishable key (pk_live_… / pk_test_…) for date deposits.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
